import("//build/ohos.gni")

## Build socketpair.so {{{
config("socketpair_config") {
  visibility = [ ":socketpair" ]

  cflags = [
    "-Wall",
    "-Werror",
    "-g3",
  ]

  if (target_cpu == "arm64" && defined(build_ext_path)) {
    socketpair_version_script =
      rebase_path("//foundation/graphic/graphic_2d/rosen/modules/composer/vsync/socketpair.versionscript",
                  root_build_dir)
    ldflags = [
      "-Wl,--version-script=${socketpair_version_script}",
      "-Wl,--emit-relocs",
      "-Wl,--no-relax",
      "-mno-fix-cortex-a53-843419",
      "-Wl,--exclude-libs=libunwind.a",
      "-Wl,--exclude-libs=libunwind_llvm.a",
      "-Wl,--exclude-libs=libc++_static.a"
    ]
  }
}

config("socketpair_public_config") {
  include_dirs = [ "export" ]
}

ohos_shared_library("socketpair") {
  branch_protector_ret = "pac_ret"

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  sources = [ "src/local_socketpair.cpp" ]

  configs = [ ":socketpair_config" ]

  public_configs = [ ":socketpair_public_config" ]

  deps = [ "//foundation/graphic/graphic_2d/utils:scoped_bytrace" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
  part_name = "graphic_2d"
  subsystem_name = "graphic"
}

group("test") {
  testonly = true
  deps = [ "test:test" ]
}
## Build socketpair.so }}}
