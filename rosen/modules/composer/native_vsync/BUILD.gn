import("//build/ohos.gni")
import("//foundation/graphic/graphic_2d/graphic_config.gni")

## Build libnative_vsync.so

config("native_vsync_config") {
  visibility = [ ":*" ]

  cflags = [
    "-Wall",
    "-Werror",
    "-g3",
  ]

  if (is_ohos && is_clang && target_cpu == "arm64" && defined(build_ext_path)) {
    libnative_vsync_version_script =
      rebase_path("//foundation/graphic/graphic_2d/rosen/modules/composer/native_vsync/libnative_vsync.versionscript",
                  root_build_dir)
    ldflags = [
      "-Wl,--version-script=${libnative_vsync_version_script}",
      "-Wl,--emit-relocs",
      "-Wl,--no-relax",
      "-mno-fix-cortex-a53-843419",
      "-Wl,--exclude-libs=libunwind.a",
      "-Wl,--exclude-libs=libunwind_llvm.a",
      "-Wl,--exclude-libs=libc++_static.a"
    ]
  }
}

config("native_vsync_public_config") {
  include_dirs =
      [ "//foundation/graphic/graphic_2d/interfaces/inner_api/composer" ]
}

ohos_shared_library("libnative_vsync") {
  branch_protector_ret = "pac_ret"

  sanitize = {
    boundary_sanitize = true
    integer_overflow = true
    ubsan = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  sources = [ "native_vsync.cpp" ]

  include_dirs = [
    "//foundation/graphic/graphic_2d/utils/log",
    "//foundation/graphic/graphic_2d/interfaces/inner_api/common",
  ]

  configs = [ ":native_vsync_config" ]

  public_configs = [ ":native_vsync_public_config" ]

  output_extension = "so"

  deps = [
    "$graphic_2d_root/rosen/modules/render_service_base:librender_service_base",
    "$graphic_2d_root/rosen/modules/render_service_client:librender_service_client",
  ]

  external_deps = [
    "eventhandler:libeventhandler",
    "hilog:libhilog",
    "c_utils:utils"
  ]

  part_name = "graphic_2d"
  subsystem_name = "graphic"
}

## Build native_vsync test
group("test") {
  testonly = true
  deps = [ "test:test" ]
}
