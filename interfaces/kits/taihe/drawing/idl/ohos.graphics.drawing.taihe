@!namespace("@ohos.graphics.drawing", "drawing")

from ohos.multimedia.image.image use PixelMap;

enum AtlasInterpolationMode : i32 {
  NONE = 0,
  FRAME_BLEND = 1,
}

struct AtlasImage {
  mode : AtlasInterpolationMode;
  rows : i32;
  cols : i32;
  frameWidth : f64;
  frameHeight : f64;
  padding : f64;
  frameIndex : f64;
  totalFrame : i32;
  atlasImage : PixelMap;
}
